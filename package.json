{
  "name": "@dsh-community/dsh-req-workbench",
  "version": "0.2.1-dsh021.1",
  "private": true,
  "description": "会话功能需求清单：AI 在项目沟通中主动整理需求，用通俗语言合并更新，在会话需求页查看。基于 Songran241/dsh-req-workbench 的非官方重构版。",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/wowswows/dsh-req-workbench.git" },
  "homepage": "https://github.com/wowswows/dsh-req-workbench#readme",
  "bugs": { "url": "https://github.com/wowswows/dsh-req-workbench/issues" },
  "type": "module",
  "main": "lib/index.js",
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE", "NOTICE.md", "THIRD_PARTY_NOTICES.md", "发布和安装指南.md"],
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-client-ui-slots", "@deepseek-ai/dsh-client-ui-conversation"],
      "platform": "web"
    }
  },
  "scripts": {
    "check:release": "node scripts/check-release.mjs",
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs"
  },
  "engines": { "dsh": "0.2.1-rc.5" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-runtime": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
